# OpenAI-compatible chat service (DashScope preset)
# 请在本地填写密钥，不要提交真实密钥。
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
# 留空时仍可检索并返回带页码的论文原文证据，但不会生成解释
CHAT_MODEL=qwen3.8-omni-flash

# Optional embeddings; leave empty to use BM25 only.
EMBEDDING_MODEL=

# Local application
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_API_URL=http://127.0.0.1:8000
TOP_K=6
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
ENABLE_OCR=false
ENABLE_VECTOR=true
VECTOR_COLLECTION=paper_chunks
RESOURCE_TOKEN=
